{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zwallet.dev/schemas/rows/ledger_entries.json",
  "title": "ledger_entries row",
  "description": "One row of `ledger_entries` as stored in a .zwallet payload. Mirrors sql/client-schema.sql.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hlc",
    "field_hlc",
    "created_at",
    "updated_at",
    "deleted_at",
    "person_id",
    "kind",
    "amount_minor",
    "currency",
    "occurred_at",
    "due_on",
    "note",
    "transaction_id",
    "split_group_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "UUIDv7, or UUIDv8 for SMS/seed/deterministic rows (ADR 0010).",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "hlc": {
      "type": "string",
      "description": "HLC of the last write = max over field_hlc (ADR 0009).",
      "pattern": "^\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}$"
    },
    "field_hlc": {
      "type": "string",
      "description": "JSON object {merge_group: hlc} encoded as a string.",
      "pattern": "^\\{(?:\"[a-z][a-z0-9_]*\":\"\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}\"(?:,\"[a-z][a-z0-9_]*\":\"\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}\")*)?\\}$"
    },
    "created_at": {
      "type": "integer",
      "description": "Epoch ms. Immutable; merge keeps the minimum.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "integer",
      "description": "Epoch ms. Merge keeps the maximum.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "deleted_at": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Epoch ms tombstone; null when live. Only the `deleted` group changes it.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "person_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "lent",
        "borrowed",
        "repaid_to_me",
        "repaid_by_me"
      ]
    },
    "amount_minor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "occurred_at": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "due_on": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-1][0-9]-[0-3][0-9]$"
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "transaction_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "split_group_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "x-immutable": [],
  "x-merge-groups": {
    "person": [
      "person_id"
    ],
    "kind": [
      "kind"
    ],
    "amount": [
      "amount_minor",
      "currency"
    ],
    "when": [
      "occurred_at"
    ],
    "due": [
      "due_on"
    ],
    "note": [
      "note"
    ],
    "links": [
      "transaction_id",
      "split_group_id"
    ],
    "deleted": [
      "deleted_at"
    ]
  },
  "x-compact": {
    "kind": "lent",
    "amount_minor": 1,
    "occurred_at": 0
  },
  "x-compact-keep": [
    "person_id"
  ]
}
