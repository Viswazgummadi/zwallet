{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zwallet.dev/schemas/rows/profile.json",
  "title": "profile row",
  "description": "One row of `profile` as stored in a .zwallet payload. Mirrors sql/client-schema.sql.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hlc",
    "field_hlc",
    "created_at",
    "updated_at",
    "deleted_at",
    "display_name",
    "default_currency",
    "month_start_day",
    "my_vpa",
    "prefs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Always 'me': there is exactly one profile row.",
      "const": "me"
    },
    "hlc": {
      "type": "string",
      "description": "HLC of the last write = max over field_hlc (ADR 0009).",
      "pattern": "^\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}$"
    },
    "field_hlc": {
      "type": "string",
      "description": "JSON object {merge_group: hlc} encoded as a string.",
      "pattern": "^\\{(?:\"[a-z][a-z0-9_]*\":\"\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}\"(?:,\"[a-z][a-z0-9_]*\":\"\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}\")*)?\\}$"
    },
    "created_at": {
      "type": "integer",
      "description": "Epoch ms. Immutable; merge keeps the minimum.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "integer",
      "description": "Epoch ms. Merge keeps the maximum.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "deleted_at": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Epoch ms tombstone; null when live. Only the `deleted` group changes it.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "month_start_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 28
    },
    "my_vpa": {
      "type": [
        "string",
        "null"
      ]
    },
    "prefs": {
      "type": "string"
    }
  },
  "x-immutable": [],
  "x-merge-groups": {
    "name": [
      "display_name"
    ],
    "currency": [
      "default_currency"
    ],
    "month_start": [
      "month_start_day"
    ],
    "vpa": [
      "my_vpa"
    ],
    "prefs": [
      "prefs"
    ],
    "deleted": [
      "deleted_at"
    ]
  },
  "x-compact": {},
  "x-compact-keep": []
}
