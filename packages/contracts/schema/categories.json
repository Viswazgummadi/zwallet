{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zwallet.dev/schemas/rows/categories.json",
  "title": "categories row",
  "description": "One row of `categories` as stored in a .zwallet payload. Mirrors sql/client-schema.sql.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hlc",
    "field_hlc",
    "created_at",
    "updated_at",
    "deleted_at",
    "parent_id",
    "name",
    "icon",
    "color_token",
    "counts_as",
    "sort_order",
    "archived",
    "system_key"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "UUIDv7, or UUIDv8 for SMS/seed/deterministic rows (ADR 0010)."
    },
    "hlc": {
      "type": "string",
      "description": "HLC of the last write = max over field_hlc (ADR 0009)."
    },
    "field_hlc": {
      "type": "string",
      "description": "JSON object {merge_group: hlc} encoded as a string."
    },
    "created_at": {
      "type": "integer",
      "description": "Epoch ms. Immutable; merge keeps the minimum."
    },
    "updated_at": {
      "type": "integer",
      "description": "Epoch ms. Merge keeps the maximum."
    },
    "deleted_at": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Epoch ms tombstone; null when live. Only the `deleted` group changes it."
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "color_token": {
      "type": "string"
    },
    "counts_as": {
      "type": "string",
      "enum": [
        "spend",
        "savings",
        "income",
        "excluded"
      ]
    },
    "sort_order": {
      "type": "integer"
    },
    "archived": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "system_key": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "x-immutable": [
    "system_key"
  ],
  "x-merge-groups": {
    "parent": [
      "parent_id"
    ],
    "name": [
      "name"
    ],
    "appearance": [
      "icon",
      "color_token"
    ],
    "counts_as": [
      "counts_as"
    ],
    "order": [
      "sort_order"
    ],
    "archived": [
      "archived"
    ],
    "deleted": [
      "deleted_at"
    ]
  }
}
