{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zwallet.dev/schemas/rows/attachments.json",
  "title": "attachments row",
  "description": "One row of `attachments` as stored in a .zwallet payload. Mirrors sql/client-schema.sql.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hlc",
    "field_hlc",
    "created_at",
    "updated_at",
    "deleted_at",
    "transaction_id",
    "mime_type",
    "byte_size",
    "sha256",
    "width",
    "height"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "UUIDv7, or UUIDv8 for SMS/seed/deterministic rows (ADR 0010)."
    },
    "hlc": {
      "type": "string",
      "description": "HLC of the last write = max over field_hlc (ADR 0009)."
    },
    "field_hlc": {
      "type": "string",
      "description": "JSON object {merge_group: hlc} encoded as a string."
    },
    "created_at": {
      "type": "integer",
      "description": "Epoch ms. Immutable; merge keeps the minimum."
    },
    "updated_at": {
      "type": "integer",
      "description": "Epoch ms. Merge keeps the maximum."
    },
    "deleted_at": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Epoch ms tombstone; null when live. Only the `deleted` group changes it."
    },
    "transaction_id": {
      "type": "string"
    },
    "mime_type": {
      "type": "string",
      "enum": [
        "image/webp",
        "image/jpeg",
        "image/png"
      ]
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "width": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "height": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "x-immutable": [
    "transaction_id",
    "mime_type",
    "byte_size",
    "sha256",
    "width",
    "height"
  ],
  "x-merge-groups": {
    "deleted": [
      "deleted_at"
    ]
  }
}
