{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zwallet.dev/schemas/rows/transactions.json",
  "title": "transactions row",
  "description": "One row of `transactions` as stored in a .zwallet payload. Mirrors sql/client-schema.sql.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hlc",
    "field_hlc",
    "created_at",
    "updated_at",
    "deleted_at",
    "type",
    "amount_minor",
    "currency",
    "original_amount_minor",
    "original_currency",
    "occurred_at",
    "occurred_tz",
    "account_id",
    "category_id",
    "merchant_id",
    "counterparty_raw",
    "note",
    "payment_method",
    "source",
    "review_state",
    "external_ref",
    "refund_of_id",
    "transfer_peer_id",
    "split_group_id",
    "my_share_minor",
    "recurring_series_id",
    "location"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "UUIDv7, or UUIDv8 for SMS/seed/deterministic rows (ADR 0010).",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "hlc": {
      "type": "string",
      "description": "HLC of the last write = max over field_hlc (ADR 0009).",
      "pattern": "^\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}$"
    },
    "field_hlc": {
      "type": "string",
      "description": "JSON object {merge_group: hlc} encoded as a string.",
      "pattern": "^\\{(?:\"[a-z][a-z0-9_]*\":\"\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}\"(?:,\"[a-z][a-z0-9_]*\":\"\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}\")*)?\\}$"
    },
    "created_at": {
      "type": "integer",
      "description": "Epoch ms. Immutable; merge keeps the minimum.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "integer",
      "description": "Epoch ms. Merge keeps the maximum.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "deleted_at": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Epoch ms tombstone; null when live. Only the `deleted` group changes it.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "enum": [
        "expense",
        "income",
        "transfer",
        "refund"
      ]
    },
    "amount_minor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "original_amount_minor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "original_currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "occurred_at": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "occurred_tz": {
      "type": "string"
    },
    "account_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "category_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "merchant_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "counterparty_raw": {
      "type": [
        "string",
        "null"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "upi",
        "card",
        "netbanking",
        "cash",
        "atm",
        "wallet",
        "auto_debit",
        "other"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "sms",
        "paste",
        "csv_import",
        "recurring_auto"
      ]
    },
    "review_state": {
      "type": "string",
      "enum": [
        "confirmed",
        "needs_review"
      ]
    },
    "external_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bank reference number from the SMS. LWW (group `ref`) so a re-parse or a user edit can correct it. Not unique: duplicates are an app-level dedup concern."
    },
    "refund_of_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "transfer_peer_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "split_group_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "my_share_minor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recurring_series_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "x-immutable": [
    "source"
  ],
  "x-merge-groups": {
    "amount": [
      "amount_minor",
      "currency",
      "original_amount_minor",
      "original_currency"
    ],
    "type": [
      "type"
    ],
    "when": [
      "occurred_at",
      "occurred_tz"
    ],
    "account": [
      "account_id"
    ],
    "category": [
      "category_id"
    ],
    "merchant": [
      "merchant_id",
      "counterparty_raw"
    ],
    "note": [
      "note"
    ],
    "method": [
      "payment_method"
    ],
    "review": [
      "review_state"
    ],
    "links": [
      "refund_of_id",
      "transfer_peer_id",
      "split_group_id",
      "my_share_minor"
    ],
    "recurring": [
      "recurring_series_id"
    ],
    "location": [
      "location"
    ],
    "ref": [
      "external_ref"
    ],
    "deleted": [
      "deleted_at"
    ]
  },
  "x-compact": {
    "type": "expense",
    "amount_minor": 1,
    "occurred_at": 0
  },
  "x-compact-keep": []
}
