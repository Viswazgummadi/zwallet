{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zwallet.dev/schemas/rows/accounts.json",
  "title": "accounts row",
  "description": "One row of `accounts` as stored in a .zwallet payload. Mirrors sql/client-schema.sql.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hlc",
    "field_hlc",
    "created_at",
    "updated_at",
    "deleted_at",
    "name",
    "kind",
    "institution",
    "last4",
    "color_token",
    "opening_balance_minor",
    "currency",
    "card_cycle_day",
    "card_due_day",
    "credit_limit_minor",
    "balance_snapshot_minor",
    "balance_snapshot_at",
    "archived"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "UUIDv7, or UUIDv8 for SMS/seed/deterministic rows (ADR 0010).",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "hlc": {
      "type": "string",
      "description": "HLC of the last write = max over field_hlc (ADR 0009).",
      "pattern": "^\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}$"
    },
    "field_hlc": {
      "type": "string",
      "description": "JSON object {merge_group: hlc} encoded as a string.",
      "pattern": "^\\{(?:\"[a-z][a-z0-9_]*\":\"\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}\"(?:,\"[a-z][a-z0-9_]*\":\"\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}\")*)?\\}$"
    },
    "created_at": {
      "type": "integer",
      "description": "Epoch ms. Immutable; merge keeps the minimum.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "integer",
      "description": "Epoch ms. Merge keeps the maximum.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "deleted_at": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Epoch ms tombstone; null when live. Only the `deleted` group changes it.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "bank",
        "credit_card",
        "cash",
        "wallet",
        "upi_lite",
        "other"
      ]
    },
    "institution": {
      "type": [
        "string",
        "null"
      ]
    },
    "last4": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2,
      "maxLength": 6
    },
    "color_token": {
      "type": [
        "string",
        "null"
      ]
    },
    "opening_balance_minor": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "card_cycle_day": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 31
    },
    "card_due_day": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 31
    },
    "credit_limit_minor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "balance_snapshot_minor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "balance_snapshot_at": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "archived": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "minimum": 0,
      "maximum": 1
    }
  },
  "x-immutable": [],
  "x-merge-groups": {
    "name": [
      "name"
    ],
    "kind": [
      "kind"
    ],
    "institution": [
      "institution",
      "last4"
    ],
    "color": [
      "color_token"
    ],
    "opening": [
      "opening_balance_minor",
      "currency"
    ],
    "card": [
      "card_cycle_day",
      "card_due_day",
      "credit_limit_minor"
    ],
    "balance": [
      "balance_snapshot_minor",
      "balance_snapshot_at"
    ],
    "archived": [
      "archived"
    ],
    "deleted": [
      "deleted_at"
    ]
  },
  "x-compact": {
    "name": "",
    "kind": "other"
  },
  "x-compact-keep": []
}
