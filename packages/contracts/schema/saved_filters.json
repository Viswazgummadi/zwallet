{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zwallet.dev/schemas/rows/saved_filters.json",
  "title": "saved_filters row",
  "description": "One row of `saved_filters` as stored in a .zwallet payload. Mirrors sql/client-schema.sql.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hlc",
    "field_hlc",
    "created_at",
    "updated_at",
    "deleted_at",
    "name",
    "query",
    "pinned",
    "sort_order"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "UUIDv7, or UUIDv8 for SMS/seed/deterministic rows (ADR 0010).",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "hlc": {
      "type": "string",
      "description": "HLC of the last write = max over field_hlc (ADR 0009).",
      "pattern": "^\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}$"
    },
    "field_hlc": {
      "type": "string",
      "description": "JSON object {merge_group: hlc} encoded as a string.",
      "pattern": "^\\{(?:\"[a-z][a-z0-9_]*\":\"\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}\"(?:,\"[a-z][a-z0-9_]*\":\"\\d{13}-[0-9a-f]{4}-[0-9a-f]{8}\")*)?\\}$"
    },
    "created_at": {
      "type": "integer",
      "description": "Epoch ms. Immutable; merge keeps the minimum.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "integer",
      "description": "Epoch ms. Merge keeps the maximum.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "deleted_at": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Epoch ms tombstone; null when live. Only the `deleted` group changes it.",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "pinned": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "minimum": 0,
      "maximum": 1
    },
    "sort_order": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "x-immutable": [],
  "x-merge-groups": {
    "name": [
      "name"
    ],
    "query": [
      "query"
    ],
    "pinned": [
      "pinned"
    ],
    "order": [
      "sort_order"
    ],
    "deleted": [
      "deleted_at"
    ]
  },
  "x-compact": {
    "name": "",
    "query": ""
  },
  "x-compact-keep": []
}
