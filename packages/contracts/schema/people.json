{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zwallet.dev/schemas/rows/people.json",
  "title": "people row",
  "description": "One row of `people` as stored in a .zwallet payload. Mirrors sql/client-schema.sql.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hlc",
    "field_hlc",
    "created_at",
    "updated_at",
    "deleted_at",
    "display_name",
    "phone_hash",
    "vpa",
    "contact_lookup_key",
    "avatar_color_token"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "UUIDv7, or UUIDv8 for SMS/seed/deterministic rows (ADR 0010)."
    },
    "hlc": {
      "type": "string",
      "description": "HLC of the last write = max over field_hlc (ADR 0009)."
    },
    "field_hlc": {
      "type": "string",
      "description": "JSON object {merge_group: hlc} encoded as a string."
    },
    "created_at": {
      "type": "integer",
      "description": "Epoch ms. Immutable; merge keeps the minimum."
    },
    "updated_at": {
      "type": "integer",
      "description": "Epoch ms. Merge keeps the maximum."
    },
    "deleted_at": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Epoch ms tombstone; null when live. Only the `deleted` group changes it."
    },
    "display_name": {
      "type": "string"
    },
    "phone_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "vpa": {
      "type": [
        "string",
        "null"
      ]
    },
    "contact_lookup_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "avatar_color_token": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "x-immutable": [],
  "x-merge-groups": {
    "name": [
      "display_name"
    ],
    "phone": [
      "phone_hash"
    ],
    "vpa": [
      "vpa"
    ],
    "contact": [
      "contact_lookup_key"
    ],
    "avatar": [
      "avatar_color_token"
    ],
    "deleted": [
      "deleted_at"
    ]
  }
}
