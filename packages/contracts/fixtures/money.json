{
  "description": "Money vectors (ADR 0003). Hand-written; both apps must pass every case. Amounts are integer minor units. MAX_MINOR = 9007199254740991 (2^53 − 1, the JS safe-integer limit, so both platforms agree). Errors are codes, not messages.",
  "max_minor": 9007199254740991,
  "currencies": {
    "description": "exponent = minor digits; symbol is a prefix (code + space when absent); grouping 'indian' = last 3 digits then pairs, 'western' = thousands. Unknown currency → error unknown_currency.",
    "INR": { "exponent": 2, "symbol": "₹", "grouping": "indian" },
    "USD": { "exponent": 2, "symbol": "$", "grouping": "western" },
    "EUR": { "exponent": 2, "symbol": "€", "grouping": "western" },
    "GBP": { "exponent": 2, "symbol": "£", "grouping": "western" },
    "AED": { "exponent": 2, "symbol": null, "grouping": "western" },
    "JPY": { "exponent": 0, "symbol": "¥", "grouping": "western" },
    "KWD": { "exponent": 3, "symbol": null, "grouping": "western" }
  },
  "parse": {
    "description": "User-typed amount → minor units. Trim surrounding ASCII spaces; commas are ignored anywhere; at most one '.'; at most `exponent` fraction digits; at least one digit. No signs, symbols or other characters. Errors: empty, invalid, too_many_decimals, overflow, unknown_currency.",
    "cases": [
      { "input": "0", "currency": "INR", "minor": 0 },
      { "input": "1", "currency": "INR", "minor": 100 },
      { "input": "1.5", "currency": "INR", "minor": 150 },
      { "input": "1.50", "currency": "INR", "minor": 150 },
      { "input": ".5", "currency": "INR", "minor": 50 },
      { "input": "5.", "currency": "INR", "minor": 500 },
      { "input": "007", "currency": "INR", "minor": 700 },
      { "input": " 42 ", "currency": "INR", "minor": 4200 },
      { "input": "1,23,456.78", "currency": "INR", "minor": 12345678 },
      { "input": "123,456.78", "currency": "INR", "minor": 12345678 },
      { "input": "0.1", "currency": "INR", "minor": 10 },
      { "input": "1234", "currency": "JPY", "minor": 1234 },
      { "input": "1.234", "currency": "KWD", "minor": 1234 },
      { "input": "90071992547409.91", "currency": "INR", "minor": 9007199254740991 },
      { "input": "1.505", "currency": "INR", "error": "too_many_decimals" },
      { "input": "12.5", "currency": "JPY", "error": "too_many_decimals" },
      { "input": "90071992547409.92", "currency": "INR", "error": "overflow" },
      { "input": "99999999999999999999", "currency": "INR", "error": "overflow" },
      { "input": "", "currency": "INR", "error": "empty" },
      { "input": "   ", "currency": "INR", "error": "empty" },
      { "input": ".", "currency": "INR", "error": "invalid" },
      { "input": "abc", "currency": "INR", "error": "invalid" },
      { "input": "-5", "currency": "INR", "error": "invalid" },
      { "input": "1.2.3", "currency": "INR", "error": "invalid" },
      { "input": "₹5", "currency": "INR", "error": "invalid" },
      { "input": "1e3", "currency": "INR", "error": "invalid" },
      { "input": "5", "currency": "XYZ", "error": "unknown_currency" }
    ]
  },
  "format": {
    "description": "Signed minor units → text. Negative values are prefixed with U+2212 (−) before the symbol. full = all fraction digits; list = like full but drops the fraction when it is all zeros (SPEC §4.1: paise hidden in lists when .00). Symbol directly followed by the number; code + U+0020 when the currency has no symbol.",
    "cases": [
      { "minor": 12345678, "currency": "INR", "style": "full", "text": "₹1,23,456.78" },
      { "minor": 0, "currency": "INR", "style": "full", "text": "₹0.00" },
      { "minor": 5, "currency": "INR", "style": "full", "text": "₹0.05" },
      { "minor": 100, "currency": "INR", "style": "full", "text": "₹1.00" },
      { "minor": 42000, "currency": "INR", "style": "full", "text": "₹420.00" },
      { "minor": -42000, "currency": "INR", "style": "full", "text": "−₹420.00" },
      { "minor": 10000000, "currency": "INR", "style": "full", "text": "₹1,00,000.00" },
      { "minor": 9999999, "currency": "INR", "style": "full", "text": "₹99,999.99" },
      { "minor": 123456789000, "currency": "INR", "style": "full", "text": "₹1,23,45,67,890.00" },
      { "minor": 1234567890, "currency": "INR", "style": "full", "text": "₹1,23,45,678.90" },
      {
        "minor": 9007199254740991,
        "currency": "INR",
        "style": "full",
        "text": "₹9,00,71,99,25,47,409.91"
      },
      { "minor": 12345600, "currency": "INR", "style": "list", "text": "₹1,23,456" },
      { "minor": 12345678, "currency": "INR", "style": "list", "text": "₹1,23,456.78" },
      { "minor": 12345670, "currency": "INR", "style": "list", "text": "₹1,23,456.70" },
      { "minor": 0, "currency": "INR", "style": "list", "text": "₹0" },
      { "minor": -16500, "currency": "INR", "style": "list", "text": "−₹165" },
      { "minor": 123456789, "currency": "USD", "style": "full", "text": "$1,234,567.89" },
      { "minor": 99, "currency": "EUR", "style": "full", "text": "€0.99" },
      { "minor": 1234567, "currency": "JPY", "style": "full", "text": "¥1,234,567" },
      { "minor": 1234567, "currency": "JPY", "style": "list", "text": "¥1,234,567" },
      { "minor": 1234, "currency": "KWD", "style": "full", "text": "KWD 1.234" },
      { "minor": 1000, "currency": "KWD", "style": "list", "text": "KWD 1" },
      { "minor": 250050, "currency": "AED", "style": "full", "text": "AED 2,500.50" }
    ]
  },
  "compact": {
    "description": "Chart axes and labels (DESIGN §2.2). No currency symbol. v = |minor| / 10^exponent. Units: INR K=10^3, L=10^5, Cr=10^7; others K=10^3, M=10^6, B=10^9. Pick the largest unit u ≤ v (or none when v < 1000). With no unit: show round_half_up(v) as an integer. With a unit: t = round_half_up(v·10/u) tenths. If the rounded value reaches the next unit (no unit: ≥ 1000; unit: t ≥ 10·next/u), move to the next unit and recompute. Show t/10 with one decimal, dropping '.0'. Integer part grouped per currency. Negative → U+2212 prefix.",
    "cases": [
      { "minor": 0, "currency": "INR", "text": "0" },
      { "minor": 49, "currency": "INR", "text": "0" },
      { "minor": 50, "currency": "INR", "text": "1" },
      { "minor": 95000, "currency": "INR", "text": "950" },
      { "minor": 99949, "currency": "INR", "text": "999" },
      { "minor": 99950, "currency": "INR", "text": "1K" },
      { "minor": 100000, "currency": "INR", "text": "1K" },
      { "minor": 950000, "currency": "INR", "text": "9.5K" },
      { "minor": 1824000, "currency": "INR", "text": "18.2K" },
      { "minor": 9999900, "currency": "INR", "text": "1L" },
      { "minor": 12000000, "currency": "INR", "text": "1.2L" },
      { "minor": 99999900, "currency": "INR", "text": "10L" },
      { "minor": 340000000, "currency": "INR", "text": "3.4Cr" },
      { "minor": 999999900, "currency": "INR", "text": "1Cr" },
      { "minor": 123456789000, "currency": "INR", "text": "123.5Cr" },
      { "minor": 1234567890000, "currency": "INR", "text": "1,234.6Cr" },
      { "minor": 1234500000000, "currency": "INR", "text": "1,234.5Cr" },
      { "minor": -214000, "currency": "INR", "text": "−2.1K" },
      { "minor": -95000, "currency": "INR", "text": "−950" },
      { "minor": 1234567800, "currency": "USD", "text": "12.3M" },
      { "minor": 99999999, "currency": "USD", "text": "1M" },
      { "minor": 250000000000, "currency": "USD", "text": "2.5B" },
      { "minor": 1500, "currency": "JPY", "text": "1.5K" }
    ]
  },
  "expression": {
    "description": "Quick-add expressions (SPEC AC-4.2.4), evaluated exactly. Grammar: expr = term (('+' | '-' | '−') term)*; term = number (('×' | '*') number)*; number = parse rules above (commas allowed, ≤ exponent decimals). Spaces are ignored. A single trailing operator is ignored (live preview while typing). Each term's product is computed exactly, then rounded once, half-up, to minor units. The result may be zero or negative (the UI disables Save); only errors are reported: empty, syntax, too_many_decimals, overflow (any intermediate or final |value| > max_minor).",
    "cases": [
      { "input": "120+45", "currency": "INR", "minor": 16500 },
      { "input": "0.1+0.2", "currency": "INR", "minor": 30 },
      { "input": "100-20.50", "currency": "INR", "minor": 7950 },
      { "input": "100−20.50", "currency": "INR", "minor": 7950 },
      { "input": " 120 + 45 ", "currency": "INR", "minor": 16500 },
      { "input": "1,000+500", "currency": "INR", "minor": 150000 },
      { "input": "12×3", "currency": "INR", "minor": 3600 },
      { "input": "12*3", "currency": "INR", "minor": 3600 },
      { "input": "2.5×40", "currency": "INR", "minor": 10000 },
      { "input": "1.25×1.5", "currency": "INR", "minor": 188 },
      { "input": "1.25×1.3", "currency": "INR", "minor": 163 },
      { "input": "0.05×0.5×0.5", "currency": "INR", "minor": 1 },
      { "input": "10+2×3", "currency": "INR", "minor": 1600 },
      { "input": "2×3×1.5", "currency": "INR", "minor": 900 },
      { "input": "120+", "currency": "INR", "minor": 12000 },
      { "input": "120×", "currency": "INR", "minor": 12000 },
      { "input": "100-200", "currency": "INR", "minor": -10000 },
      { "input": "100-100", "currency": "INR", "minor": 0 },
      { "input": "42", "currency": "INR", "minor": 4200 },
      { "input": "100+1", "currency": "JPY", "minor": 101 },
      { "input": "1.5×2", "currency": "KWD", "minor": 3000 },
      { "input": "", "currency": "INR", "error": "empty" },
      { "input": "+5", "currency": "INR", "error": "syntax" },
      { "input": "5++3", "currency": "INR", "error": "syntax" },
      { "input": "5/2", "currency": "INR", "error": "syntax" },
      { "input": "5+-3", "currency": "INR", "error": "syntax" },
      { "input": "1.2.3+1", "currency": "INR", "error": "syntax" },
      { "input": "1.234+1", "currency": "INR", "error": "too_many_decimals" },
      { "input": "90071992547409.91+0.01", "currency": "INR", "error": "overflow" },
      { "input": "90071992547409.91×2", "currency": "INR", "error": "overflow" }
    ]
  }
}
