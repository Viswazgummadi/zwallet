    {"name":"unknown groups (incl. one named \"constructor\") keep the max stamp on both sides, values untouched","table":"transactions","local":{"extra_stamp":{"constructor":"A1","future_group":"B1"}},"incoming":{"extra_stamp":{"constructor":"B1","future_group":"A1"}}},
    {"name":"unknown group \"constructor\" present only in the file is adopted","table":"transactions","local":{},"incoming":{"extra_stamp":{"constructor":"B1"}}},
    {"name":"unknown group present only locally is kept; nothing to write","table":"transactions","local":{"extra_stamp":{"constructor":"B1","future_group":"A1"}},"incoming":{}},
