    {"name":"compaction keeps NOT NULL foreign keys (ledger_entries.person_id)","table":"ledger_entries","local":{},"incoming":{"compacted":{"hlc":"B2","deleted_at":1760000400000},"set":{"updated_at":1760000400000}},"incoming_frontier":{"aaaaaaaa":"H0","bbbbbbbb":"B2"}}
