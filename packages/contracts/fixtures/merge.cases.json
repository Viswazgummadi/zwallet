{
  "description": "Hand-written merge cases. scripts/vectors.mjs expands them into full rows and computes expected results with lib/merge-reference.mjs → merge.json (generated, never hand-edit). A side is `null` (row absent) or a patch on `base`: `set` columns, `stamp` groups with an HLC, `unstamp` groups (remove from field_hlc). Every group of `base` starts stamped with `base_hlc`. Frontiers default to the frontier of the side's own row (ADR 0017).",
  "hlcs": {
    "H0": "1760000000000-0000-aaaaaaaa",
    "A1": "1760000100000-0000-aaaaaaaa",
    "B1": "1760000200000-0000-bbbbbbbb",
    "A2": "1760000300000-0000-aaaaaaaa",
    "B2": "1760000400000-0000-bbbbbbbb",
    "B2c": "1760000400000-0001-bbbbbbbb"
  },
  "tables": {
    "transactions": {
      "base_hlc": "H0",
      "base": {
        "id": "01920000-0000-7000-8000-000000000001",
        "created_at": 1760000000000,
        "updated_at": 1760000000000,
        "deleted_at": null,
        "type": "expense",
        "amount_minor": 42000,
        "currency": "INR",
        "original_amount_minor": null,
        "original_currency": null,
        "occurred_at": 1759990000000,
        "occurred_tz": "Asia/Kolkata",
        "account_id": "acct-sbi",
        "category_id": "cat-food",
        "merchant_id": "m-swiggy",
        "counterparty_raw": "swiggy.stores@axl",
        "note": null,
        "payment_method": "upi",
        "source": "sms",
        "review_state": "confirmed",
        "external_ref": "512345678901",
        "refund_of_id": null,
        "transfer_peer_id": null,
        "split_group_id": null,
        "my_share_minor": null,
        "recurring_series_id": null,
        "location": null
      }
    },
    "ledger_entries": {
      "base_hlc": "H0",
      "base": {
        "id": "01920000-0000-7000-8000-0000000000aa",
        "created_at": 1760000000000,
        "updated_at": 1760000000000,
        "deleted_at": null,
        "person_id": "p-rahul",
        "kind": "lent",
        "amount_minor": 120000,
        "currency": "INR",
        "occurred_at": 1759990000000,
        "due_on": null,
        "note": "Goa trip",
        "transaction_id": null,
        "split_group_id": null
      }
    },
    "transaction_tags": {
      "base_hlc": "H0",
      "base": {
        "id": "tt-1",
        "created_at": 1760000000000,
        "updated_at": 1760000000000,
        "deleted_at": null,
        "transaction_id": "01920000-0000-7000-8000-000000000001",
        "tag_id": "tag-reimbursable"
      }
    }
  },
  "cases": [
    { "name": "insert: row absent locally is inserted verbatim", "table": "transactions",
      "local": null, "incoming": {} },
    { "name": "identical rows: unchanged", "table": "transactions",
      "local": {}, "incoming": {} },
    { "name": "incoming newer note wins; local was seen by the file → no conflict", "table": "transactions",
      "local": {}, "incoming": { "set": { "note": "Dinner with Asha", "updated_at": 1760000200000 }, "stamp": { "note": "B1" } } },
    { "name": "local newer note kept against an old file → unchanged", "table": "transactions",
      "local": { "set": { "note": "Dinner", "updated_at": 1760000100000 }, "stamp": { "note": "A1" } }, "incoming": {} },
    { "name": "AC-11.2: different groups edited on each side both survive", "table": "transactions",
      "local": { "set": { "category_id": "cat-groceries" }, "stamp": { "category": "A1" } },
      "incoming": { "set": { "note": "office lunch" }, "stamp": { "note": "B1" } } },
    { "name": "AC-11.3: same group edited on both sides, incoming later wins, local value logged", "table": "transactions",
      "local": { "set": { "note": "from phone" }, "stamp": { "note": "A1" } },
      "incoming": { "set": { "note": "from laptop" }, "stamp": { "note": "B1" } } },
    { "name": "AC-11.3: same group edited on both sides, local later wins, incoming value logged", "table": "transactions",
      "local": { "set": { "note": "from phone" }, "stamp": { "note": "A2" } },
      "incoming": { "set": { "note": "from laptop" }, "stamp": { "note": "B1" } } },
    { "name": "ADR 0017: incoming edit made after seeing ours is an update, not a conflict", "table": "transactions",
      "local": { "set": { "note": "from phone" }, "stamp": { "note": "A1" } },
      "incoming": { "set": { "note": "edited on laptop" }, "stamp": { "note": "B1", "review": "A1" } } },
    { "name": "equal values with different stamps: newer stamp kept, no conflict", "table": "transactions",
      "local": { "set": { "note": "same" }, "stamp": { "note": "A1" } },
      "incoming": { "set": { "note": "same" }, "stamp": { "note": "B1" } } },
    { "name": "amount group moves together (amount + currency + original)", "table": "transactions",
      "local": { "set": { "amount_minor": 50000 }, "stamp": { "amount": "A1" } },
      "incoming": { "set": { "amount_minor": 1999, "currency": "USD", "original_amount_minor": 1999, "original_currency": "USD" }, "stamp": { "amount": "B1" } } },
    { "name": "incoming tombstone deletes a live row", "table": "transactions",
      "local": {}, "incoming": { "set": { "deleted_at": 1760000200000 }, "stamp": { "deleted": "B1" } } },
    { "name": "AC-11.4: later field edit never resurrects a deleted row", "table": "transactions",
      "local": { "set": { "deleted_at": 1760000100000 }, "stamp": { "deleted": "A1" } },
      "incoming": { "set": { "note": "edited after" }, "stamp": { "note": "B1" } } },
    { "name": "AC-11.4: an old file never resurrects a deletion", "table": "transactions",
      "local": { "set": { "deleted_at": 1760000300000 }, "stamp": { "deleted": "A2" } }, "incoming": {} },
    { "name": "restore (newer deleted-group write with null) brings the row back", "table": "transactions",
      "local": { "set": { "deleted_at": 1760000100000 }, "stamp": { "deleted": "A1" } },
      "incoming": { "set": { "deleted_at": null }, "stamp": { "deleted": "B1", "note": "A1" } } },
    { "name": "delete after a concurrent restore stays deleted; restore logged", "table": "transactions",
      "local": { "set": { "deleted_at": 1760000300000 }, "stamp": { "deleted": "A2" } },
      "incoming": { "set": { "deleted_at": null }, "stamp": { "deleted": "B1" } } },
    { "name": "group missing in the file's field_hlc counts as '' → local wins", "table": "transactions",
      "local": { "set": { "note": "kept" }, "stamp": { "note": "A1" } },
      "incoming": { "set": { "note": "unstamped" }, "unstamp": ["note"] } },
    { "name": "group missing locally → incoming wins", "table": "transactions",
      "local": { "set": { "note": "unstamped" }, "unstamp": ["note"] },
      "incoming": { "set": { "note": "stamped" }, "stamp": { "note": "B1" } } },
    { "name": "tie (same stamp, different values) → larger value wins (direction 1)", "table": "transactions",
      "local": { "set": { "note": "apple" }, "stamp": { "note": "B2" } },
      "incoming": { "set": { "note": "banana" }, "stamp": { "note": "B2" } } },
    { "name": "tie (same stamp, different values) → larger value wins (direction 2)", "table": "transactions",
      "local": { "set": { "note": "banana" }, "stamp": { "note": "B2" } },
      "incoming": { "set": { "note": "apple" }, "stamp": { "note": "B2" } } },
    { "name": "tie order: null < integer < string", "table": "transactions",
      "local": { "set": { "note": null }, "stamp": { "note": "B2" } },
      "incoming": { "set": { "note": "x" }, "stamp": { "note": "B2" } } },
    { "name": "HLC counter orders edits within the same millisecond", "table": "transactions",
      "local": { "set": { "note": "first" }, "stamp": { "note": "B2" } },
      "incoming": { "set": { "note": "second" }, "stamp": { "note": "B2c" } } },
    { "name": "created_at keeps the minimum, updated_at the maximum", "table": "transactions",
      "local": { "set": { "created_at": 1760000050000, "updated_at": 1760000300000, "note": "n" }, "stamp": { "note": "A2" } },
      "incoming": { "set": { "updated_at": 1760000200000 } } },
    { "name": "several groups at once: mixed winners", "table": "transactions",
      "local": { "set": { "category_id": "cat-groceries", "note": "phone note", "review_state": "needs_review" }, "stamp": { "category": "A2", "note": "A1", "review": "A1" } },
      "incoming": { "set": { "category_id": "cat-restaurants", "note": "laptop note", "payment_method": "card" }, "stamp": { "category": "B1", "note": "B2", "method": "B1" } } },
    { "name": "ledger entry: amount edit on one side, note on the other", "table": "ledger_entries",
      "local": { "set": { "amount_minor": 100000 }, "stamp": { "amount": "A1" } },
      "incoming": { "set": { "note": "Goa trip (fuel)" }, "stamp": { "note": "B1" } } },
    { "name": "transaction_tags: removing a tag (tombstone) merges; file frontier covers our stamp → no conflict", "table": "transaction_tags",
      "local": {}, "incoming": { "set": { "deleted_at": 1760000200000 }, "stamp": { "deleted": "B1" } },
      "incoming_frontier": { "aaaaaaaa": "H0", "bbbbbbbb": "B1" } },
    { "name": "transaction_tags: re-adding after removal on the other side (restore wins by HLC)", "table": "transaction_tags",
      "local": { "set": { "deleted_at": 1760000200000 }, "stamp": { "deleted": "B1" } },
      "incoming": { "set": { "deleted_at": null }, "stamp": { "deleted": "A2" } } }
  ]
}
