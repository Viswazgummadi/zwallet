  "cases": [
    { "name": "insert: row absent locally is inserted verbatim", "table": "transactions",
      "local": null, "incoming": {} },
    { "name": "identical rows: unchanged", "table": "transactions",
      "local": {}, "incoming": {} },
    { "name": "incoming newer note wins; local was seen by the file → no conflict", "table": "transactions",
      "local": {}, "incoming": { "set": { "note": "Dinner with Asha", "updated_at": 1760000200000 }, "stamp": { "note": "B1" } } },
    { "name": "local newer note kept against an old file → unchanged", "table": "transactions",
      "local": { "set": { "note": "Dinner", "updated_at": 1760000100000 }, "stamp": { "note": "A1" } }, "incoming": {} },
    { "name": "AC-11.2: different groups edited on each side both survive", "table": "transactions",
      "local": { "set": { "category_id": "01920000-0000-7000-8000-0000000000c2" }, "stamp": { "category": "A1" } },
      "incoming": { "set": { "note": "office lunch" }, "stamp": { "note": "B1" } } },
    { "name": "AC-11.3: same group edited on both sides, incoming later wins, local value logged", "table": "transactions",
      "local": { "set": { "note": "from phone" }, "stamp": { "note": "A1" } },
      "incoming": { "set": { "note": "from laptop" }, "stamp": { "note": "B1" } } },
    { "name": "AC-11.3: same group edited on both sides, local later wins, incoming value logged", "table": "transactions",
      "local": { "set": { "note": "from phone" }, "stamp": { "note": "A2" } },
      "incoming": { "set": { "note": "from laptop" }, "stamp": { "note": "B1" } } },
    { "name": "ADR 0017: incoming edit made after seeing ours is an update, not a conflict", "table": "transactions",
      "local": { "set": { "note": "from phone" }, "stamp": { "note": "A1" } },
      "incoming": { "set": { "note": "edited on laptop" }, "stamp": { "note": "B1", "review": "A1" } } },
    { "name": "equal values with different stamps: newer stamp kept, no conflict", "table": "transactions",
      "local": { "set": { "note": "same" }, "stamp": { "note": "A1" } },
      "incoming": { "set": { "note": "same" }, "stamp": { "note": "B1" } } },
    { "name": "amount group moves together (amount + currency + original)", "table": "transactions",
      "local": { "set": { "amount_minor": 50000 }, "stamp": { "amount": "A1" } },
