    { "name": "several groups at once: mixed winners", "table": "transactions",
      "local": { "set": { "category_id": "01920000-0000-7000-8000-0000000000c2", "note": "phone note", "review_state": "needs_review" }, "stamp": { "category": "A2", "note": "A1", "review": "A1" } },
      "incoming": { "set": { "category_id": "01920000-0000-7000-8000-0000000000c3", "note": "laptop note", "payment_method": "card" }, "stamp": { "category": "B1", "note": "B2", "method": "B1" } } },
    { "name": "ledger entry: amount edit on one side, note on the other", "table": "ledger_entries",
      "local": { "set": { "amount_minor": 100000 }, "stamp": { "amount": "A1" } },
      "incoming": { "set": { "note": "Goa trip (fuel)" }, "stamp": { "note": "B1" } } },
    { "name": "transaction_tags: removing a tag (tombstone) merges; file frontier covers our stamp → no conflict", "table": "transaction_tags",
      "local": {}, "incoming": { "set": { "deleted_at": 1760000200000 }, "stamp": { "deleted": "B1" } },
      "incoming_frontier": { "aaaaaaaa": "H0", "bbbbbbbb": "B1" } },
    { "name": "transaction_tags: re-adding after removal on the other side (restore wins by HLC)", "table": "transaction_tags",
      "local": { "set": { "deleted_at": 1760000200000 }, "stamp": { "deleted": "B1" } },
      "incoming": { "set": { "deleted_at": null }, "stamp": { "deleted": "A2" } } },
    {"name":"error: field_hlc with whitespace is malformed","table":"transactions","local":{},"incoming":{"raw":{"field_hlc":"{\"note\": \"1760000200000-0000-bbbbbbbb\"}"}},"expect_error":"malformed_field_hlc"},
    {"name":"error: field_hlc stamp with non-hex node is malformed","table":"transactions","local":{},"incoming":{"raw":{"field_hlc":"{\"note\":\"1760000200000-0000-zzzzzzzz\"}"}},"expect_error":"malformed_field_hlc"},
