    {"name":"error: field_hlc with a trailing newline is malformed","table":"transactions","local":{},"incoming":{"raw":{"field_hlc":"{}\n"}},"expect_error":"malformed_field_hlc"},
    {"name":"error: uppercase hex in a stamp is malformed","table":"transactions","local":{},"incoming":{"raw":{"field_hlc":"{\"note\":\"1760000200000-0000-BBBBBBBB\"}"}},"expect_error":"malformed_field_hlc"},
    {"name":"error: group name with capitals is malformed","table":"transactions","local":{},"incoming":{"raw":{"field_hlc":"{\"Note\":\"1760000200000-0000-bbbbbbbb\"}"}},"expect_error":"malformed_field_hlc"},
    {"name":"error: short wall clock in a stamp is malformed","table":"transactions","local":{},"incoming":{"raw":{"field_hlc":"{\"note\":\"760000200000-0000-bbbbbbbb\"}"}},"expect_error":"malformed_field_hlc"},
    {"name":"error: malformed local field_hlc is rejected too","table":"transactions","local":{"raw":{"field_hlc":"{\"note\":\"9\"}"}},"incoming":{},"expect_error":"malformed_field_hlc"},
