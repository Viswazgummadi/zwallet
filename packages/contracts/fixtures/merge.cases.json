    {"name":"external_ref edited on both sides: later stamp wins, losing ref logged","table":"transactions","local":{"set":{"external_ref":"LOCAL-REF"},"stamp":{"ref":"A1"}},"incoming":{"set":{"external_ref":"FILE-REF"},"stamp":{"ref":"B1"}}},
    {"name":"seed-like: equal values, newer stamps and earlier created_at → unchanged but write","table":"transactions","local":{},"incoming":{"stamp_all":"B1","set":{"created_at":1759999999999}}},
    {"name":"tombstone for a row we never had → inserted_deleted","table":"transactions","local":null,"incoming":{"set":{"deleted_at":1760000200000},"stamp":{"deleted":"B1"}}},
    {"name":"both sides deleted with different deleted_at → unchanged value-wise, but write","table":"transactions","local":{"set":{"deleted_at":1760000100000},"stamp":{"deleted":"A1"}},"incoming":{"set":{"deleted_at":1760000200000},"stamp":{"deleted":"B1"}}},
    {"name":"only stamps differ (no value change): unchanged, write","table":"transactions","local":{"set":{"note":"same"},"stamp":{"note":"A1"}},"incoming":{"set":{"note":"same"},"stamp":{"note":"B1","category":"B1"}}},
    {"name":"compacted tombstone beats an older full row and never resurrects (file side)","table":"transactions","local":{},"incoming":{"compacted":{"hlc":"B2","deleted_at":1760000400000},"set":{"updated_at":1760000400000}},"incoming_frontier":{"aaaaaaaa":"H0","bbbbbbbb":"B2"}},
    {"name":"compacted tombstone beats an older full row and never resurrects (local side)","table":"transactions","local":{"compacted":{"hlc":"B2","deleted_at":1760000400000},"set":{"updated_at":1760000400000}},"incoming":{"stamp_all":"A2","set":{"note":"late edit","deleted_at":null}},"local_frontier":{"aaaaaaaa":"A2","bbbbbbbb":"B2"}},
