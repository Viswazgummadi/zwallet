      "incoming": { "set": { "note": "edited after" }, "stamp": { "note": "B1" } } },
    { "name": "AC-11.4: an old file never resurrects a deletion", "table": "transactions",
      "local": { "set": { "deleted_at": 1760000300000 }, "stamp": { "deleted": "A2" } }, "incoming": {} },
    { "name": "restore (newer deleted-group write with null) brings the row back", "table": "transactions",
      "local": { "set": { "deleted_at": 1760000100000 }, "stamp": { "deleted": "A1" } },
