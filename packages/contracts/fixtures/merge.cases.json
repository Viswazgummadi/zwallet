    {"name":"immutable columns that differ: same result in the other direction","table":"transactions","local":{},"incoming":{"set":{"source":"manual"}}},
    {"name":"immutable on a system row: null loses to a value (tags.system_key)","table":"tags","local":{},"incoming":{"set":{"system_key":"reimbursable"}}},
