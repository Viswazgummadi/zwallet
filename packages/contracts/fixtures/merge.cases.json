    "A1": "1760000100000-0000-aaaaaaaa",
    "B1": "1760000200000-0000-bbbbbbbb",
    "A2": "1760000300000-0000-aaaaaaaa",
    "B2": "1760000400000-0000-bbbbbbbb",
    "B2c": "1760000400000-0001-bbbbbbbb"
  },
