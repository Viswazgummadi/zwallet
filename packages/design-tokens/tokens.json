{
  "$schema": "https://zwallet.dev/schemas/tokens.v1.json",
  "$description": "Single source of design tokens. build.ts generates Kotlin (core/designsystem) and CSS custom properties (apps/web). Never hardcode these values elsewhere.",
  "brand": {
    "seed": "#0B6E69",
    "name": "zwallet",
    "note": "Material 3 tonal palettes are generated from the seed with material-color-utilities (scheme: TonalSpot, contrast 0). Dynamic color (Android 12+) is optional and OFF by default so charts and brand stay consistent."
  },
  "color": {
    "light": {
      "page": "#F7F7F4",
      "surface": "#FCFCFB",
      "surfaceRaised": "#FFFFFF",
      "surfaceSunken": "#F0EFEC",
      "inkPrimary": "#0B0B0B",
      "inkSecondary": "#52514E",
      "inkMuted": "#6E6C67",
      "hairline": "#E1E0D9",
      "axis": "#C3C2B7",
      "primary": "#0B6E69",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "#BFEDE6",
      "onPrimaryContainer": "#00201E",
      "focusRing": "#0B6E69",
      "amountIncome": "#006300",
      "amountExpense": "#0B0B0B",
      "amountTransfer": "#52514E",
      "scrim": "rgba(11,11,11,0.32)"
    },
    "dark": {
      "page": "#0B0C0E",
      "surface": "#121417",
      "surfaceRaised": "#1A1D21",
      "surfaceSunken": "#0E1012",
      "inkPrimary": "#F0EFEC",
      "inkSecondary": "#C3C2B7",
      "inkMuted": "#9A988F",
      "hairline": "#2C2C2A",
      "axis": "#383835",
      "primary": "#7FD6CC",
      "onPrimary": "#003734",
      "primaryContainer": "#00504C",
      "onPrimaryContainer": "#BFEDE6",
      "focusRing": "#7FD6CC",
      "amountIncome": "#4CC46B",
      "amountExpense": "#F0EFEC",
      "amountTransfer": "#C3C2B7",
      "scrim": "rgba(0,0,0,0.56)"
    },
    "amoled": { "page": "#000000", "surface": "#000000", "surfaceRaised": "#101113" }
  },
  "dataviz": {
    "validated": "Categorical slots validated with dataviz/validate_palette.js: light vs #FCFCFB (adjacent CVD ΔE 9.1, normal 19.6; contrast WARN on slots 3,4,5 → relief rule: direct labels/table view always available), dark vs #121417 (CVD 8.4, normal 19.3, all ≥3:1). Max 8 named series; 9th+ folds into 'Other'. Scatter/dot/all-pairs forms: max 3 series.",
    "categorical": {
      "light": ["#2A78D6", "#EB6834", "#1BAF7A", "#EDA100", "#E87BA4", "#008300", "#6250D6", "#E34948"],
      "dark":  ["#3987E5", "#D95926", "#199E70", "#C98500", "#D55181", "#008300", "#9085E9", "#E66767"]
    },
    "other": { "light": "#A9A79F", "dark": "#5E5C57" },
    "sequential": {
      "hue": "blue",
      "steps": { "100": "#CDE2FB", "150": "#B7D3F6", "200": "#9EC5F4", "250": "#86B6EF", "300": "#6DA7EC", "350": "#5598E7", "400": "#3987E5", "450": "#2A78D6", "500": "#256ABF", "550": "#1C5CAB", "600": "#184F95", "650": "#104281", "700": "#0D366B" },
      "zero": { "light": "#F0EFEC", "dark": "#1E2125" }
    },
    "diverging": { "negative": "#E34948", "neutral": { "light": "#F0EFEC", "dark": "#383835" }, "positive": "#2A78D6", "note": "Used for 'vs typical' deltas. Blue = less spend than typical (good), red = more. Always with +/− sign and label." },
    "single": { "light": "#2A78D6", "dark": "#3987E5", "note": "Default hue for single-series charts (category bars, pace line)." },
    "ghost": { "light": "#C3C2B7", "dark": "#4A4945", "note": "Comparison marks: last month line (dashed is NOT used — use ghost color + label), typical bars." },
    "band": { "light": "rgba(42,120,214,0.12)", "dark": "rgba(57,135,229,0.18)", "note": "Forecast cone / typical range." },
    "areaWashOpacity": 0.10
  },
  "status": {
    "good": "#0CA30C",
    "warning": "#FAB219",
    "serious": "#EC835A",
    "critical": "#D03B3B",
    "rule": "Status colors only for budget/alert states, always with icon + label. Never used as series colors. Ordinary spending is never red."
  },
  "categoryIdentity": {
    "note": "Each category group owns a fixed identity color used for its icon container & avatar (identity, always paired with icon + name). In multi-series charts, groups map to categorical slots by user-stable order (top 7 by 12-month spend at first run, persisted) + Other.",
    "containers": {
      "food": "slot1", "groceries": "slot3", "transport": "slot2", "housing": "slot7",
      "bills": "slot4", "shopping": "slot5", "health": "slot6", "entertainment": "slot8",
      "travel": "slot1", "education": "slot7", "personal_care": "slot5", "family": "slot2",
      "finance": "other", "investments": "slot6", "income": "slot6", "system": "other"
    },
    "containerTone": "Icon container = slot color at 16% alpha on surface; glyph = slot color at full strength (dark: slot dark step). Contrast of glyph vs container ≥ 3:1 is verified by a token test."
  },
  "typography": {
    "family": { "sans": "Inter", "fallback": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
    "features": { "amountsInLists": "tnum", "heroAmounts": "default proportional", "allNumbers": "ss01 off, cv11 on (single-storey a off)" },
    "scale": {
      "display":   { "size": 44, "line": 52, "weight": 600, "tracking": -0.02 },
      "headline":  { "size": 28, "line": 36, "weight": 600, "tracking": -0.01 },
      "title":     { "size": 20, "line": 28, "weight": 600, "tracking": 0 },
      "titleSm":   { "size": 16, "line": 24, "weight": 600, "tracking": 0 },
      "body":      { "size": 16, "line": 24, "weight": 400, "tracking": 0 },
      "bodySm":    { "size": 14, "line": 20, "weight": 400, "tracking": 0 },
      "label":     { "size": 14, "line": 20, "weight": 500, "tracking": 0.01 },
      "labelSm":   { "size": 12, "line": 16, "weight": 500, "tracking": 0.02 },
      "amountLg":  { "size": 34, "line": 40, "weight": 600, "tracking": -0.02 },
      "amountRow": { "size": 16, "line": 24, "weight": 600, "tracking": 0, "features": "tnum" }
    }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 28, "full": 999 },
  "elevation": { "note": "Tonal elevation only (surfaceRaised). Shadows only on FAB, menus and dragged items: y=2 blur=8 rgba(0,0,0,0.12) light; none in dark." },
  "motion": {
    "spring": {
      "spatialFast":    { "damping": 0.9, "stiffness": 1400 },
      "spatialDefault": { "damping": 0.9, "stiffness": 700 },
      "spatialSlow":    { "damping": 0.9, "stiffness": 300 },
      "effectsFast":    { "damping": 1.0, "stiffness": 3800 },
      "effectsDefault": { "damping": 1.0, "stiffness": 1600 },
      "bouncy":         { "damping": 0.6, "stiffness": 800, "use": "FAB press, success check, chip select only" }
    },
    "duration": { "micro": 100, "short": 200, "medium": 300, "long": 450 },
    "easing": { "emphasizedDecel": "cubic-bezier(0.05, 0.7, 0.1, 1)", "emphasizedAccel": "cubic-bezier(0.3, 0, 0.8, 0.15)", "standard": "cubic-bezier(0.2, 0, 0, 1)" },
    "chartStagger": 18,
    "reducedMotion": "All springs → 0ms crossfade 120ms; number tickers → instant; chart enter → fade only."
  },
  "size": { "touchMin": 48, "rowHeight": 64, "rowHeightDense": 52, "fab": 64, "iconSm": 20, "icon": 24, "avatar": 40, "avatarLg": 64, "keypadKey": 72 },
  "breakpoints": { "compact": 0, "medium": 600, "expanded": 840, "large": 1200, "xlarge": 1600 }
}
